# 复制为 .env 后按需调整；FIXFLOW_ 前缀用于区分本项目和其他程序的配置。
# 作用：服务名称；Settings 读取，main.py 和健康响应使用，便于确认当前服务。
FIXFLOW_APP_NAME=FixFlow
# 作用：应用报告版本；main.py 与健康响应读取，可在部署时调整而不改接口代码。
FIXFLOW_APP_VERSION=0.1.0
# 作用：运行环境标识；Settings 校验，只有 test 才允许隔离 SQLite，防止静默换库。
FIXFLOW_ENVIRONMENT=development
# 作用：是否开放接口文档；create_app 读取，同时控制文档网页和结构描述。
FIXFLOW_DOCS_ENABLED=true
# 列表必须保留外层方括号和双引号；来源包括协议、主机、端口。
# 作用：允许浏览器读取响应的网页来源；create_app 配置跨来源中间件，按协议、主机、端口精确匹配。
FIXFLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 必须先安装 PostgreSQL、创建 fixflow 数据库和专用账号。
# 默认留空，健康接口仍可访问；业务接口明确返回数据库未配置。
# 密码如含 @、:、/ 等字符，需进行网址编码；实际连接只写入本机 .env。
# FIXFLOW_DATABASE_URL=postgresql+psycopg://fixflow_app:替换为编码后的密码@127.0.0.1:5432/fixflow
# 作用：数据库连接信息；Settings 读取、create_database_engine 使用，真实值只留本机，供驱动认证连接。
FIXFLOW_DATABASE_URL=
# 作用：每个进程连接池的常驻连接上限；创建引擎时读取，按需借用而非每个用户独占连接。
FIXFLOW_DATABASE_POOL_SIZE=5
# 作用：每个进程高峰时额外连接额度；创建引擎时读取，限制数据库总连接压力。
FIXFLOW_DATABASE_MAX_OVERFLOW=5
# 作用：等待连接池可用连接的最长秒数；池耗尽时及时失败，不让请求无限排队。
FIXFLOW_DATABASE_POOL_TIMEOUT_SECONDS=5
# 作用：新建网络连接的等待秒数；传给 Psycopg，连接失败可以及时给出不可用状态。
FIXFLOW_DATABASE_CONNECT_TIMEOUT_SECONDS=3

# 登录凭证一小时到期；同账号连续失败五次暂锁五分钟。
# 作用：登录凭证有效分钟数；authenticate_user 换算为到期秒数，身份校验按数据库期限拒绝过期凭证。
FIXFLOW_SESSION_TTL_MINUTES=60
# 作用：同账号连续错误上限；authenticate_user 持久化计数并在达到阈值时暂时锁定。
FIXFLOW_LOGIN_MAX_ATTEMPTS=5
# 作用：账号暂时锁定秒数；authenticate_user 计算截止时间，避免每次输错都永久禁止登录。
FIXFLOW_LOGIN_LOCK_SECONDS=300
